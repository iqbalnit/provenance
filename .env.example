# Copy to .env (gitignored) and fill in. Never commit real values, never paste them into chat.
#
# Choose ONE Gemini backend.
#
# --- Free (no billing account): Google AI Studio API key from https://aistudio.google.com ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
#
# --- Paid / AI Builder Cup credits: Vertex AI in your GCP project ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=
# # Vertex model endpoint location for the pinned models (from the model listing): often "global" for newer models.
# GOOGLE_CLOUD_LOCATION=global
# PROVENANCE_BQ_DATASET=provenance
# PROVENANCE_GCS_BUCKET=

# Pinned Gemini 3.x IDs, exactly as your backend lists them. No -latest aliases.
PROVENANCE_MODEL_FLASH=
PROVENANCE_MODEL_PRO=
